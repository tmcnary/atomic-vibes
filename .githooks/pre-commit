#!/bin/bash
# pre-commit hook - Validates test immutability before allowing commits
#
# This hook is automatically installed by scripts/install-hooks.sh
# or manually with: git config core.hooksPath .githooks

# Only check if feature-requirements.json is being committed
if git diff --cached --name-only | grep -q "feature-requirements.json"; then
    echo ""
    echo "📋 Detected changes to feature-requirements.json"
    echo "   Validating test immutability..."
    echo ""

    if ! ./scripts/validate-tests.sh; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "❌ COMMIT BLOCKED"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "Test immutability validation failed."
        echo ""
        echo "To fix:"
        echo "  1. Revert changes to test steps/descriptions"
        echo "  2. Only modify the 'passes' field"
        echo "  3. Or flag incorrect tests for human review"
        echo ""
        echo "To bypass (NOT RECOMMENDED):"
        echo "  git commit --no-verify"
        echo ""
        exit 1
    fi

    echo ""
fi

# All checks passed
exit 0
